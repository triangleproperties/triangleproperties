rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Inquiries Collection (CRM Leads & Contact Form)
    // - Public website clients can submit (create) inquiries/forms
    // - Only Firebase Authenticated Admins can view (read), update status, or delete leads
    match /inquiries/{inquiryId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // 2. Properties Collection
    // - Public visitors can view properties
    // - Only Firebase Authenticated Admins can create, update, or delete properties
    match /properties/{propertyId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 3. Categories Collection
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 4. Gallery Collection
    match /gallery/{imageId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 5. Services Collection
    match /services/{serviceId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 6. Testimonials / Reviews Collection
    match /testimonials/{reviewId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 7. Settings Collection (company, construction, about, jointVenture)
    match /settings/{settingId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 8. Blog Posts Collection
    match /blogPosts/{postId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 8. Backward Compatibility App Data
    match /app_data/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 9. Default Fallback: Lock down all other document paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
